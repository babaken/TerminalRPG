# ===== タイルセット =====
# glyph は表示幅 2（全角 1 文字）。曖昧幅の記号（■ ▼ ─ など）は避ける

[[tileset]]
id = "default"
[tileset.tiles]
"#" = { glyph = "＃", pass = false, color = "gray",         name = "壁" }
"." = { glyph = "．", pass = true,  color = "green",        name = "地面" }
"T" = { glyph = "木", pass = false, color = "bright_green", name = "木" }
"~" = { glyph = "～", pass = false, color = "bright_blue",  name = "水" }
"H" = { glyph = "家", pass = false, color = "yellow",       name = "家" }
"D" = { glyph = "戸", pass = true,  color = "yellow",       name = "戸口" }
"," = { glyph = "畑", pass = true,  color = "green",        name = "畑" }
"t" = { glyph = "机", pass = false, color = "yellow",       name = "家具" }
"S" = { glyph = "祠", pass = false, color = "bright_cyan",  name = "祠" }
"=" = { glyph = "：", pass = true,  color = "yellow",       name = "道" }

# ===== マップ =====

[[map]]
id = "village_lito"
name = "リト村"
tileset = "default"
rows = [
  "TTTTTTTTTTTTTTT.TTTTTTTTTTTTTTTT",
  "T..............................T",
  "T..HHH.........................T",
  "T..HDH.......HHH.....~~~~......T",
  "T............HDH.....~~~~......T",
  "T....................~~~~......T",
  "T..............................T",
  "T...,,,,,,..........HHH........T",
  "T...,,,,,,..........HDH........T",
  "T...,,,,,,.....................T",
  "T..............................T",
  "T......HHH.....................T",
  "T......HDH...........,,,,,,....T",
  "T....................,,,,,,....T",
  "T..............................T",
  "T..............................T",
  "T..............................T",
  "TTTTTTTTTTTTTTT.TTTTTTTTTTTTTTTT",
]

[[map.warp]]          # 主人公の家の戸口
x = 4
y = 3
to = "house_hero"
tx = 5
ty = 6

[[map.warp]]          # 村長の家の戸口
x = 14
y = 4
to = "house_chief"
tx = 5
ty = 6

[[map.warp]]          # 北の出口 → 囁きの森
x = 15
y = 0
to = "forest_1"
tx = 15
ty = 14

[[map.event]]         # 家から初めて出たとき：カイが誘いに来る
x = 4
y = 4
trigger = "auto"
label = "ch1_kai_invite"
when = "!flag.ch1_invited"

[[map.event]]         # 南の出口（村を出るまでは通れない）
