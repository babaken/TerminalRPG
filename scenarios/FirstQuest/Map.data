# ===== タイルセット =====
# glyph は表示幅 2（全角 1 文字）。曖昧幅の記号（■ ▼ ─ など）は避ける

[[tileset]]
id = "default"
[tileset.tiles]
"#" = { glyph = "＃", pass = false, color = "gray",         name = "壁" }
"." = { glyph = "．", pass = true,  color = "green",        name = "地面" }
"T" = { glyph = "木", pass = false, color = "bright_green", name = "木" }
"~" = { glyph = "～", pass = false, color = "bright_blue",  name = "水" }
"H" = { glyph = "家", pass = false, color = "yellow",       name = "家" }
"D" = { glyph = "戸", pass = true,  color = "yellow",       name = "戸口" }
"," = { glyph = "畑", pass = true,  color = "green",        name = "畑" }
"t" = { glyph = "机", pass = false, color = "yellow",       name = "家具" }
"S" = { glyph = "祠", pass = false, color = "bright_cyan",  name = "祠" }
"=" = { glyph = "：", pass = true,  color = "yellow",       name = "道" }
"R" = { glyph = "岩", pass = false, color = "white",        name = "岩壁" }
"_" = { glyph = "．", pass = true,  color = "gray",         name = "洞穴の床" }
"<" = { glyph = "上", pass = true,  color = "bright_white", name = "上り階段" }
">" = { glyph = "下", pass = true,  color = "bright_white", name = "下り階段" }
"C" = { glyph = "穴", pass = true,  color = "bright_white", name = "洞穴の入口" }
"B" = { glyph = "箱", pass = false, color = "bright_yellow", name = "宝箱" }
"b" = { glyph = "箱", pass = false, color = "gray",         name = "開いた宝箱" }
"P" = { glyph = "袋", pass = false, color = "yellow",       name = "荷物" }
"O" = { glyph = "泉", pass = false, color = "bright_cyan",  name = "回復の泉" }
"M" = { glyph = "陣", pass = true,  color = "bright_magenta", name = "魔法陣の跡" }

# ===== マップ =====

[[map]]
