[[item]]
id = "leather_robe"
name = "皮のローブ"
type = "equipment"
slot = "armor"
category = "robe"
price = 250
desc = "なめし革で補強したローブ。魔法使い・僧侶向け。"
stats = { def = 7, mag = 4 }

[[item]]
id = "rod"
name = "ロッド"
type = "equipment"
slot = "weapon"
category = "staff"
price = 300
desc = "魔力を込めやすい杖。魔法使い・僧侶向け。魔法の威力と回復量が上がる。"
stats = { atk = 5, mag = 10 }

[[item]]
id = "hard_leather_robe"
name = "硬革のローブ"
type = "equipment"
slot = "armor"
category = "robe"
price = 700
desc = "硬く煮しめた革を重ねたローブ。鎖帷子に負けない守り。魔法使い・僧侶向け。"
stats = { def = 14, mag = 7 }

[[item]]
id = "magic_rod"
name = "マジックロッド"
type = "equipment"
slot = "weapon"
category = "staff"
price = 800
desc = "魔石をはめ込んだ杖。魔法の威力と回復量が大きく上がる。魔法使い・僧侶向け。"
stats = { atk = 10, mag = 20 }

[[item]]
id = "return_scroll"
name = "帰還の巻物"
type = "key"
desc = "最後に立ち寄った街へ一瞬で戻れる。"
use = { field = true, effect = "script", label = "use_return_scroll" }

[[item]]
id = "adventurer_card"
name = "冒険者証"
type = "key"
desc = "冒険者協会の登録証。"

[[item]]
id = "traveler_clothes"
