type = "equipment"
slot = "armor"
category = "light_armor"
price = 40
stats = { def = 4 }
desc = "丈夫な布で仕立てた旅の服。母が用意してくれた。"

[[item]]
id = "wood_shield"
name = "きのたて"
type = "equipment"
slot = "shield"
category = "shield"
price = 40
stats = { def = 3 }

[[item]]
id = "cat_collar"
