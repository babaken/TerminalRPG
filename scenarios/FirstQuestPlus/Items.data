price = 5
desc = "HP を 10 回復する。ほんのり甘い。"
use = { field = true, battle = true, target = "ally_one", effect = "heal", power = 10 }

[[item]]
id = "package"
name = "道具屋の荷物"
type = "key"
desc = "宿屋「旅鳥亭」に届ける荷物。"

