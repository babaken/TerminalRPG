category = "accessory"
price = 20
stats = { luk = 3, agi = 1 }
desc = "鈴のついた首輪。持ち主の運が少し良くなる気がする。"

[[item]]
id = "antidote"
name = "どくけしそう"
type = "consumable"
price = 10
desc = "毒を消す。"
use = { field = true, battle = true, target = "ally_one", effect = "cure", status = "poison" }

[[item]]
id = "bread"
