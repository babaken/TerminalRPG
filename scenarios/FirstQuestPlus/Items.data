# ===== アイテム =====

[[item]]
id = "herb"
name = "やくそう"
type = "consumable"
price = 8
desc = "HP を 30 回復する。"
use = { field = true, battle = true, target = "ally_one", effect = "heal", power = 30 }

[[item]]
