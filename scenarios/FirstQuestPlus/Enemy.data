# ===== 3 章：記憶の場所（主人公ひとりの戦い）・洞穴の奥 =====
[[enemy]]
id = "shadow_hero"            # 器の影。FirstQuest の試練のように能力を写す（copy）と勝率 1 割ほどなので、固定の強さにした
name = "影の{hero}"
aa = "aa/shadow_hero.txt"
stats = { hp = 180, atk = 46, def = 28, agi = 22, luk = 8 }   # 一人で Lv 14 で約 8 割、Lv 16 で約 9 割勝てる
exp = 0
gold = 0
immune_status = ["poison"]

[[enemy]]
id = "nari_child"           # 子供の姿のなりそこない（B13F。逃がすこともできる）
name = "小さななりそこない"
aa = "aa/narisokonai.txt"
stats = { hp = 60, atk = 12, def = 6, agi = 12, luk = 2 }
exp = 30
gold = 0
ai = "pattern"
[[enemy.actions]]
skill = "attack"

[[group]]
id = "shadow"               # 囁きの森の祠：影の{hero}
members = ["shadow_hero"]

[[group]]
id = "mem_hill"             # リト村の丘：父と星を見た夜（夜の魔物）
members = ["shadow_knight"]

[[group]]
id = "mem_guild"            # ベルンの協会：はじめての依頼の記憶
members = ["goblin_captain", "drill_mole"]

[[group]]
id = "nari_child"
members = ["nari_child"]

